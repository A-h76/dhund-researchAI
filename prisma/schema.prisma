// --- DHB-28 harness ---

model PersistenceConventionFixture {
  id         String   @id @db.Uuid
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  metadata   Json     @map("metadata") @db.JsonB
  costMicros BigInt   @map("cost_micros")

  @@map("_persistence_convention_fixture")
}

// --- 003 iam ---

model User {
  id              String    @id @db.Uuid
  email           String?   @unique(map: "users_email_key") @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  displayName     String    @map("display_name")
  sessionVersion  Int       @default(1) @map("session_version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  credential          Credential?
  sessions            Session[]
  refreshTokenFamilies RefreshTokenFamily[]
  totpSecret          TotpSecret?
  mfaRecoveryCodes    MfaRecoveryCode[]
  authTokens          AuthToken[]
  ownedOrganizations   Organization[]        @relation("OrganizationOwner")
  orgMemberships       OrgMembership[]
  projectMemberships   ProjectMembership[]
  uploadSessions       UploadSession[]
  mergeReviews         MergeCandidate[]
  researchRunsInitiated ResearchRun[]
  screeningCriteriaCreated ScreeningCriteria[]
  screeningDecisions   ScreeningDecision[]
  writingsCreated      Writing[]
  writingVersionsCreated WritingVersion[]
  conversationsCreated Conversation[]
  importSessionsInitiated ReferenceManagerImportSession[]

  @@map("users")
}

model Credential {
  id           String   @id @db.Uuid
  userId       String   @unique(map: "credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Session {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deviceFingerprint String?   @map("device_fingerprint")
  issuedAt          DateTime  @map("issued_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  sessionVersion    Int       @map("session_version")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenFamilies RefreshTokenFamily[]

  @@map("sessions")
}

model RefreshTokenFamily {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  currentTokenHash String    @unique(map: "refresh_token_families_current_token_hash_key") @map("current_token_hash")
  issuedAt         DateTime  @map("issued_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("refresh_token_families")
}

model TotpSecret {
  id               String    @id @db.Uuid
  userId           String    @unique(map: "totp_secrets_user_id_key") @map("user_id") @db.Uuid
  secretCiphertext Bytes     @map("secret_ciphertext")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_secrets")
}

model MfaRecoveryCode {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @map("code_hash")
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash], map: "mfa_recovery_codes_user_id_code_hash_key")
  @@map("mfa_recovery_codes")
}

model AuthToken {
  id         String           @id @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique(map: "uq_auth_tokens_hash") @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

// --- 004 tenancy ---

model Organization {
  id          String    @id @db.Uuid
  kind        OrgKind
  name        String
  ownerUserId String?   @map("owner_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  owner              User?            @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships        OrgMembership[]
  projects           Project[]
  subscriptions      Subscription[]
  usageCounters      UsageCounter[]
  documents          Document[]
  uploadSessions     UploadSession[]
  aiExecutions       AiExecution[]
  researchRuns       ResearchRun[]

  @@map("organizations")
}

model OrgMembership {
  id        String    @id @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      OrgRole
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("org_memberships")
}

model Project {
  id        String    @id @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  name      String
  settings  Json      @default("{}") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  memberships         ProjectMembership[]
  uploadSessions      UploadSession[]
  documents           Document[]
  externalRecords     ExternalRecord[]
  discoveryCandidates DiscoveryCandidate[]
  sources             Source[]
  aiExecutions        AiExecution[]
  researchRuns        ResearchRun[]
  extractionSchemas   ExtractionSchema[]
  screeningCriteria   ScreeningCriteria[]
  screeningDecisions  ScreeningDecision[]
  writings            Writing[]
  conversations       Conversation[]
  libraryFolders      LibraryFolder[]
  libraryItems        LibraryItem[]
  importSessions      ReferenceManagerImportSession[]
  retrievalTraces     RetrievalTrace[]

  @@map("projects")
}

model ProjectMembership {
  id        String      @id @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("project_memberships")
}

// --- 005 billing ---

model Subscription {
  id                   String   @id @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  stripeSubscriptionId String   @unique(map: "subscriptions_stripe_subscription_id_key") @map("stripe_subscription_id")
  planCode             String   @map("plan_code")
  status               String
  periodStart          DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd            DateTime @map("period_end") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model UsageCounter {
  id          String      @id @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  period      String
  periodStart DateTime    @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime    @map("period_end") @db.Timestamptz(3)
  metric      UsageMetric
  value       BigInt      @default(0)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, period, metric], map: "usage_counters_org_id_period_metric_key")
  @@map("usage_counters")
}

/// Stripe webhook replay ledger. PK is Stripe's event id (TEXT) — not UUIDv7.
model StripeEvent {
  id          String            @id
  type        String
  payload     Json              @db.JsonB
  receivedAt  DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?         @map("processed_at") @db.Timestamptz(3)
  status      StripeEventStatus @default(received)

  @@map("stripe_events")
}

model IdempotencyRecord {
  id                 String   @id @db.Uuid
  scope              String
  key                String
  requestFingerprint String   @map("request_fingerprint")
  responseHash       String?  @map("response_hash")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([scope, key], map: "idempotency_records_scope_key_key")
  @@map("idempotency_records")
}

// --- 006 ai ledger ---

model AiExecution {
  id               String       @id @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  projectId        String?      @map("project_id") @db.Uuid
  researchRunId    String?      @map("research_run_id") @db.Uuid
  capability       AiCapability
  provider         String
  model            String
  promptVersion    String       @map("prompt_version")
  inputFingerprint String       @map("input_fingerprint")
  status           AiStatus
  method           AiMethod
  tokensIn         Int          @default(0) @map("tokens_in")
  tokensOut        Int          @default(0) @map("tokens_out")
  costMicros       BigInt       @default(0) @map("cost_micros")
  latencyMs        Int          @default(0) @map("latency_ms")
  correlationId    String       @map("correlation_id")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization     Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  project          Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  researchRun      ResearchRun?          @relation(fields: [researchRunId], references: [id], onDelete: Restrict)
  attempts         AiExecutionAttempt[]
  evidence         Evidence[]
  extractionCells  ExtractionCell[]
  screeningDecisions ScreeningDecision[]
  messages         Message[]

  @@map("ai_executions")
}

model AiExecutionAttempt {
  id            String   @id @db.Uuid
  aiExecutionId String   @map("ai_execution_id") @db.Uuid
  attemptNo     Int      @map("attempt_no")
  provider      String
  model         String
  status        AiStatus
  error         String?
  latencyMs     Int      @map("latency_ms")
  costMicros    BigInt   @map("cost_micros")

  aiExecution AiExecution @relation(fields: [aiExecutionId], references: [id], onDelete: Cascade)

  @@unique([aiExecutionId, attemptNo], map: "ai_execution_attempts_ai_execution_id_attempt_no_key")
  @@map("ai_execution_attempts")
}

// --- 007 identity (GLOBAL) ---

model CanonicalWork {
  id              String            @id @db.Uuid
  canonicalTitle  String            @map("canonical_title")
  authorHash      String            @map("author_hash")
  year            Int?
  type            CanonicalWorkType
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  manifestations       WorkManifestation[]
  externalIdentifiers  ExternalIdentifier[]
  relationshipsFrom    WorkRelationship[]   @relation("WorkRelationshipFrom")
  relationshipsTo      WorkRelationship[]   @relation("WorkRelationshipTo")
  mergeCandidatesAsCandidate MergeCandidate[] @relation("MergeCandidateWork")
  mergeCandidatesAsExisting  MergeCandidate[] @relation("MergeExistingWork")
  documents            Document[]
  externalRecords      ExternalRecord[]
  discoveryCandidates  DiscoveryCandidate[]

  @@map("canonical_works")
}

model WorkManifestation {
  id                         String  @id @db.Uuid
  canonicalWorkId            String  @map("canonical_work_id") @db.Uuid
  manifestationType          String  @map("manifestation_type")
  bibliographicMetadata      Json    @map("bibliographic_metadata") @db.JsonB
  preferredSourceConnectorId String? @map("preferred_source_connector_id")

  canonicalWork CanonicalWork @relation(fields: [canonicalWorkId], references: [id], onDelete: Cascade)

  @@map("work_manifestations")
}

model ExternalIdentifier {
  id              String           @id @db.Uuid
  canonicalWorkId String           @map("canonical_work_id") @db.Uuid
  scheme          IdentifierScheme
  value           String

  canonicalWork CanonicalWork @relation(fields: [canonicalWorkId], references: [id], onDelete: Cascade)

  @@unique([scheme, value], map: "external_identifiers_scheme_value_key")
  @@map("external_identifiers")
}

model WorkRelationship {
  id         String               @id @db.Uuid
  fromWorkId String               @map("from_work_id") @db.Uuid
  toWorkId   String               @map("to_work_id") @db.Uuid
  type       WorkRelationshipType
  provenance Json                 @db.JsonB

  fromWork CanonicalWork @relation("WorkRelationshipFrom", fields: [fromWorkId], references: [id], onDelete: Cascade)
  toWork   CanonicalWork @relation("WorkRelationshipTo", fields: [toWorkId], references: [id], onDelete: Cascade)

  @@unique([fromWorkId, toWorkId, type], map: "work_relationships_from_to_type_key")
  @@map("work_relationships")
}

model MergeCandidate {
  id              String          @id @db.Uuid
  candidateWorkId String          @map("candidate_work_id") @db.Uuid
  existingWorkId  String          @map("existing_work_id") @db.Uuid
  matchType       MergeMatchType  @map("match_type")
  evidence        Json            @db.JsonB
  status          MergeStatus     @default(pending)
  reviewedBy      String?         @map("reviewed_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidateWork CanonicalWork @relation("MergeCandidateWork", fields: [candidateWorkId], references: [id], onDelete: Restrict)
  existingWork  CanonicalWork @relation("MergeExistingWork", fields: [existingWorkId], references: [id], onDelete: Restrict)
  reviewer      User?         @relation(fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@map("merge_candidates")
}

// --- 008 rights + external ---

model RightsSnapshot {
  id            String   @id @db.Uuid
  connectorId   String   @map("connector_id")
  policyVersion String   @map("policy_version")
  capabilities  Json     @db.JsonB
  capturedAt    DateTime @map("captured_at") @db.Timestamptz(3)

  externalRecords ExternalRecord[]
  documents       Document[]

  @@unique([connectorId, policyVersion], map: "rights_snapshots_connector_id_policy_version_key")
  @@map("rights_snapshots")
}

model ExternalRecord {
  id                    String             @id @db.Uuid
  projectId             String             @map("project_id") @db.Uuid
  connectorId           String             @map("connector_id")
  externalId            String             @map("external_id")
  type                  ExternalRecordType
  linkedCanonicalWorkId String?            @map("linked_canonical_work_id") @db.Uuid
  rightsSnapshotId      String             @map("rights_snapshot_id") @db.Uuid
  lastCheckedAt         DateTime?          @map("last_checked_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  linkedCanonicalWork CanonicalWork?           @relation(fields: [linkedCanonicalWorkId], references: [id], onDelete: SetNull)
  rightsSnapshot      RightsSnapshot           @relation(fields: [rightsSnapshotId], references: [id], onDelete: Restrict)
  snapshots           ExternalRecordSnapshot[]
  sources             Source[]
  libraryItems        LibraryItem[]

  @@map("external_records")
}

model ExternalRecordSnapshot {
  id               String   @id @db.Uuid
  externalRecordId String   @map("external_record_id") @db.Uuid
  capturedAt       DateTime @map("captured_at") @db.Timestamptz(3)
  contentRef       String?  @map("content_ref")
  metadata         Json     @db.JsonB

  externalRecord ExternalRecord @relation(fields: [externalRecordId], references: [id], onDelete: Cascade)

  @@map("external_record_snapshots")
}

model DiscoveryCandidate {
  id                      String          @id @db.Uuid
  projectId               String          @map("project_id") @db.Uuid
  queryId                 String          @map("query_id") @db.Uuid
  connectorId             String          @map("connector_id")
  externalId              String          @map("external_id")
  metadata                Json            @db.JsonB
  resolvedCanonicalWorkId String?         @map("resolved_canonical_work_id") @db.Uuid
  status                  DiscoveryStatus @default(pending_admission)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt               DateTime?       @map("expires_at") @db.Timestamptz(3)

  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolvedCanonicalWork CanonicalWork? @relation(fields: [resolvedCanonicalWorkId], references: [id], onDelete: SetNull)

  @@unique([projectId, queryId, connectorId, externalId], map: "discovery_candidates_project_query_connector_external_key")
