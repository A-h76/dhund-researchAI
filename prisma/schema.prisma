  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation    Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiExecution     AiExecution?             @relation(fields: [aiExecutionId], references: [id], onDelete: Restrict)
  evidenceBindings MessageEvidenceBinding[]

  @@unique([conversationId, sequence], map: "messages_conversation_id_sequence_key")
  @@map("messages")
}

model MessageEvidenceBinding {
  id         String   @id @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  evidenceId String   @map("evidence_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([messageId, evidenceId], map: "message_evidence_bindings_message_id_evidence_id_key")
  @@map("message_evidence_bindings")
}

// --- 019 library ---

model LibraryFolder {
  id             String    @id @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  parentFolderId String?   @map("parent_folder_id") @db.Uuid
  name           String
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentFolder LibraryFolder?  @relation("LibraryFolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders LibraryFolder[] @relation("LibraryFolderHierarchy")
  items        LibraryItem[]

  @@map("library_folders")
}

model LibraryItem {
  id               String    @id @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  folderId         String?   @map("folder_id") @db.Uuid
  documentId       String?   @map("document_id") @db.Uuid
  externalRecordId String?   @map("external_record_id") @db.Uuid
  position         Int       @default(0)
  metadata         Json      @default("{}") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder         LibraryFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  externalRecord ExternalRecord? @relation(fields: [externalRecordId], references: [id], onDelete: Cascade)

  @@map("library_items")
}

// --- 020 connectors ---

model ConnectorCache {
  id        String   @id @db.Uuid
  provider  String
  cacheKey  String   @map("cache_key")
  value     Json     @db.JsonB
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, cacheKey], map: "connector_cache_provider_cache_key_key")
  @@map("connector_cache")
}

model ReferenceManagerImportSession {
  id             String             @id @db.Uuid
  projectId      String             @map("project_id") @db.Uuid
  source         String
  initiatedBy    String             @map("initiated_by") @db.Uuid
  state          ImportSessionState @default(CREATED)
  itemsTotal     Int?               @map("items_total")
  itemsAdmitted  Int                @default(0) @map("items_admitted")
  itemsRejected  Int                @default(0) @map("items_rejected")
  errors         Json               @default("[]") @db.JsonB
  idempotencyKey String             @map("idempotency_key")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  terminalAt     DateTime?          @map("terminal_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  initiator User    @relation(fields: [initiatedBy], references: [id], onDelete: Restrict)

  @@unique([projectId, idempotencyKey], map: "refmgr_import_sessions_project_idempotency_key")
  @@map("reference_manager_import_sessions")
}

/// DHB-57 durable retrieval provenance. Postgres holds the fingerprint and
/// the trace body (JSONB). No second database; object storage is not required.
model RetrievalTrace {
  id               String   @id @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  queryFingerprint String   @map("query_fingerprint")
  embeddingModel   String   @map("embedding_model")
  embeddingVersion String   @map("embedding_version")
  k                Int
  overFetchFactor  Int      @map("over_fetch_factor")
  efSearch         Int      @map("ef_search")
  fallbacksUsed    Json     @default("[]") @map("fallbacks_used") @db.JsonB
  body             Json     @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, queryFingerprint], map: "idx_retrieval_traces_project_fingerprint")
  @@map("retrieval_traces")
}
