// DHB-28 Prisma conventions:
// - PostgreSQL only (no SQLite, no create_all)
// - PKs: native UUID, application-generated UUIDv7 via platform generateId()
// - NEVER @default(uuid()) / DB-generated IDs
// - created_at / updated_at are real TIMESTAMPTZ columns — never UUIDv7 embedded time
// - snake_case tables/columns; camelCase Prisma fields via @map
// - money/cost as integer micros (BigInt) — never Float
// - jsonb where Design Master specifies jsonb
//
// PersistenceConventionFixture is a DHB-28 harness table only — not a product domain model.
//
// DHB-29: product schema foundation (migrations 001–005).
// Documented PK exception: stripe_events.id is Stripe's event id (TEXT), not UUIDv7.
// Partial unique indexes and CHECK constraints live in migration SQL (Prisma cannot express them).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, citext]
}

